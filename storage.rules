rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsFolder(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // A 2026-07-24 change (canManageEventFiles(), since removed) gated
    // event-file writes on a cross-service firestore.get() checking role and
    // status before allowing the upload. That call denied every account -
    // Super User and Admin alike - in production, despite those same
    // accounts working fine everywhere else and despite a local
    // Firestore+Storage emulator reproduction of the identical rule text
    // authorizing both account types correctly. Since the two environments
    // disagreed on the exact same rule text, the cross-service read itself
    // was the suspect, not account data. Firestore's own rules already keep
    // event documents server-write-only regardless of what this file
    // allows, so ownership plus the existing size/type checks below is back
    // to being the only gate here - the same one this project ran on for
    // weeks before that change, rather than keep debugging an unverifiable
    // production-only cross-service failure.

    function validImageUpload() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validPdfUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    match /event-images/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if ownsFolder(userId) && validImageUpload();
      allow delete: if ownsFolder(userId);
    }

    match /event-documents/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if ownsFolder(userId) && validPdfUpload();
      allow delete: if ownsFolder(userId);
    }
  }
}
