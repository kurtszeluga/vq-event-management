# Client (Vite). Copy to .env.local for local development.
# Also set these on Vercel so the frontend build receives Firebase config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server (Vercel API routes). Set in the Vercel project environment.
# Not required for `npm run dev` unless you are exercising local API routes.
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Optional. Service account used only for the Google Sheet registration sync.
# Falls back to FIREBASE_SERVICE_ACCOUNT_JSON when unset, so this is only needed
# if you want the key that can reach the guild's Drive to be separate from the
# one that mints Firebase tokens. The switch and the Shared Drive folder ID are
# not here - they are in Configuration > Google Sheets.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Optional server helpers
# Public site origin used in email links when Vercel URL inference is not enough
APP_ORIGIN=
# Set to true only for local/testing when rate limits should be bypassed
DISABLE_API_RATE_LIMITS=
# Fallback used by some admin APIs when VITE_FIREBASE_API_KEY is unavailable at runtime
FIREBASE_API_KEY=
