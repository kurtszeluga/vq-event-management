{
  "name": "vq-event-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:client": "vitest run",
    "setup:first-admin": "node scripts/setupFirstAdmin.mjs",
    "backfill:member-directory": "node scripts/backfillMemberDirectoryProfiles.mjs",
    "audit:zero-capacity": "node scripts/auditZeroCapacityEvents.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project vq-rules-test \"node --test --test-concurrency=1 tests/rules/*.test.js\""
  },
  "dependencies": {
    "firebase": "^12.1.0",
    "firebase-admin": "^14.1.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "docx": "^9.7.1",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.24.0",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.10"
  }
}
